# Copy to .env and adjust. Never commit a real .env.

# PostgreSQL connection used by the server and migrations.
DATABASE_URL=postgres://hollowrite:hollowrite@127.0.0.1:5432/hollowrite
# Database used by `make test-db` (integration tests create their own rows).
TEST_DATABASE_URL=postgres://hollowrite:hollowrite@127.0.0.1:5432/hollowrite_test

# Address the game server listens on (HTTP + WebSocket).
HOLLOWRITE_BIND=127.0.0.1:7700
# Directory with balance, maps, items, actors and dialogue.
HOLLOWRITE_CONTENT_DIR=content
# Serve the built web client from here (empty = auto-detect apps/web/dist).
HOLLOWRITE_WEB_DIR=
# Comma separated browser origins allowed to open the game socket. Empty
# means http://localhost:<port>, http://127.0.0.1:<port> and the Vite dev port.
HOLLOWRITE_ALLOWED_ORIGINS=
# Set to 1 behind TLS so the session cookie carries the Secure flag.
HOLLOWRITE_SECURE_COOKIES=0
# Days a login session stays valid.
HOLLOWRITE_SESSION_DAYS=14
# New accounts allowed per IP per hour.
HOLLOWRITE_REGISTRATIONS_PER_HOUR=10
# WebSocket connections allowed per IP in a burst (then 1 per second).
HOLLOWRITE_CONNECT_BURST=20
# Expose /metrics beyond loopback (keep 0 unless it is firewalled).
HOLLOWRITE_PUBLIC_METRICS=0
# World RNG seed; change to vary drops and AI choices between runs.
HOLLOWRITE_SEED=
# Logging: RUST_LOG filter and text|json output.
RUST_LOG=info,sqlx=warn
HOLLOWRITE_LOG_FORMAT=text

# Terminal client default server.
HOLLOWRITE_SERVER=http://127.0.0.1:7700
